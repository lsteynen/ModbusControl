<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="modbuscontrol">
		<xs:complexType>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element name="size">
					<xs:complexType>
						<xs:all>
							<xs:element name="width" type="xs:unsignedInt" minOccurs="0"/>
							<xs:element name="height" type="xs:unsignedInt" minOccurs="0"/>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="modbus">
					<xs:complexType>
						<xs:all>
							<xs:element name="connection" type="tpConnection" minOccurs="0"/>
							<xs:element name="port" type="xs:string" minOccurs="0"/>
							<xs:element name="baudrate" type="tpBaudrate" minOccurs="0"/>
							<xs:element name="parity" type="tpParity" minOccurs="0"/>
							<xs:element name="endofmessagetimeout" type="xs:unsignedInt" minOccurs="0"/>
							<xs:element name="onewireechosuppression" type="tpBool" minOccurs="0"/>
							<xs:element name="ipaddress" type="xs:string" minOccurs="0"/>
							<xs:element name="ipport" type="tpIPPort" minOccurs="0"/>
							<xs:element name="slaveid" type="tpModbusSlaveID" minOccurs="0"/>
							<xs:element name="maximumframesize" minOccurs="0">
								<xs:simpleType>
									<xs:restriction base="xs:integer">
										<xs:minInclusive value="13"/>
										<xs:maxInclusive value="256"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="interframedelay" type="xs:unsignedInt" minOccurs="0"/>
							<xs:element name="writeholdingregisterfc" type="tpModbusWriteFC" minOccurs="0"/>
							<xs:element name="int32endian" type="tpEndian" minOccurs="0"/>
							<xs:element name="float32endian" type="tpEndian" minOccurs="0"/>
							<xs:element name="ascii16endian" type="tpEndian" minOccurs="0"/>
							<xs:element name="showinfo" type="tpBool" minOccurs="0"/>
							<xs:element name="holdingregisterstart" type="tpModbusHoldingRegisterStart" minOccurs="0"/>
							<xs:element name="responsetimeout" type="xs:unsignedInt" minOccurs="0"/>
							<xs:element name="samplerate" type="xs:unsignedInt" minOccurs="0"/>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="autostart">
					<xs:complexType>
						<xs:all>
							<xs:element name="enable" type="tpBool" minOccurs="0"/>
							<xs:element name="page" type="xs:string" minOccurs="0"/>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="modbustcpserver">
					<xs:complexType>
						<xs:all>
							<xs:element name="enable" type="tpBool" minOccurs="0"/>
							<xs:element name="port" type="tpIPPort" minOccurs="0"/>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="tab">
					<xs:complexType>
						<xs:choice maxOccurs="unbounded">
							<xs:element name="name" type="xs:string" minOccurs="1"/>
							<xs:element name="rw" type="tpReadWrite"/>
							<xs:element name="minlen">
								<xs:simpleType>
									<xs:restriction base="xs:integer">
										<xs:minInclusive value="1"/>
										<xs:maxInclusive value="32"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="decimals">
								<xs:simpleType>
									<xs:restriction base="xs:integer">
										<xs:minInclusive value="0"/>
										<xs:maxInclusive value="12"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="fcol" type="xs:string"/>
							<xs:element name="bcol" type="xs:string"/>
							<xs:element name="expandfields" type="tpBool"/>
							<xs:element name="var">
								<xs:complexType>
									<xs:choice maxOccurs="unbounded">
										<xs:element name="reg" minOccurs="1">
										   <xs:simpleType>
											 <xs:union memberTypes="tpRegNum40000 tpRegNum400000 tpRegAutonum"/>
										   </xs:simpleType>
										</xs:element>
										<xs:element name="text" type="xs:string"/>
										<xs:element name="longdescr" type="xs:string"/>
										<xs:element name="type" type="tpVarType"/>
										<xs:element name="rw" type="tpReadWrite"/>
										<xs:element name="minlen">
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:minInclusive value="1"/>
													<xs:maxInclusive value="32"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="decimals">
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:minInclusive value="0"/>
													<xs:maxInclusive value="12"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="fcol" type="xs:string"/>
										<xs:element name="bcol" type="xs:string"/>
										<xs:element name="expandfields" type="tpBool"/>
										<xs:element name="enum" type="tpEnum"/>
										<xs:element name="field">
											<xs:complexType>
												<xs:all>
													<xs:element name="pos" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:integer">
																<xs:minInclusive value="0"/>
																<xs:maxInclusive value="31"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="width" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:integer">
																<xs:minInclusive value="1"/>
																<xs:maxInclusive value="32"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="text" type="xs:string" minOccurs="0"/>
													<xs:element name="longdescr" type="xs:string" minOccurs="0"/>
													<xs:element name="type" type="tpFieldType" minOccurs="0"/>
													<xs:element name="minlen" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:integer">
																<xs:minInclusive value="1"/>
																<xs:maxInclusive value="32"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="fcol" type="xs:string" minOccurs="0"/>
													<xs:element name="bcol" type="xs:string" minOccurs="0"/>
													<xs:element name="enum" type="tpEnum" minOccurs="0"/>
												</xs:all>
											</xs:complexType>
										</xs:element>
									</xs:choice>
								</xs:complexType>
							</xs:element>
						</xs:choice>
					</xs:complexType>
				</xs:element>
				<xs:element name="include">
					<xs:complexType>
						<xs:all>
							<xs:element name="file" type="xs:string" minOccurs="1"/>
							<xs:element name="required" type="tpBool" minOccurs="0"/>
						</xs:all>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="tpConnection">
		<xs:restriction base="xs:string">
			<xs:enumeration value="serial/rtu"/>
			<xs:enumeration value="modbus/tcp"/>
			<xs:enumeration value="rtu/tcp"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="tpBaudrate">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="50"/>
			<xs:maxInclusive value="99999999"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="tpBool">
		<xs:restriction base="xs:string">
			<xs:enumeration value="true"/>
			<xs:enumeration value="false"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="tpEndian">
		<xs:restriction base="xs:string">
			<xs:enumeration value="big"/>
			<xs:enumeration value="little"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="tpParity">
		<xs:restriction base="xs:string">
			<xs:enumeration value="none"/>
			<xs:enumeration value="odd"/>
			<xs:enumeration value="even"/>
			<xs:enumeration value="mark"/>
			<xs:enumeration value="space"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="tpIPPort">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="65535"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="tpModbusSlaveID">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="0"/>
			<xs:maxInclusive value="255"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="tpModbusHoldingRegisterStart">
		<xs:restriction base="xs:integer">
			<xs:enumeration value="40000"/>
			<xs:enumeration value="40001"/>
			<xs:enumeration value="400000"/>
			<xs:enumeration value="400001"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="tpModbusWriteFC">
		<xs:restriction base="xs:string">
			<xs:enumeration value="6"/>
			<xs:enumeration value="06"/>
			<xs:enumeration value="16"/>
			<xs:enumeration value="auto"/>
			<xs:enumeration value="alternate"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="tpReadWrite">
		<xs:restriction base="xs:string">
			<xs:enumeration value="r"/>
			<xs:enumeration value="w"/>
			<xs:enumeration value="rw"/>
			<xs:enumeration value="wr"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="tpVarType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="int16"/>
			<xs:enumeration value="uint16"/>
			<xs:enumeration value="int32"/>
			<xs:enumeration value="uint32"/>
			<xs:enumeration value="hex16"/>
			<xs:enumeration value="hex32"/>
			<xs:enumeration value="bin16"/>
			<xs:enumeration value="bin32"/>
			<xs:enumeration value="float32"/>
			<xs:enumeration value="ascii16"/>
			<xs:enumeration value="ascii32"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="tpFieldType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="int"/>
			<xs:enumeration value="uint"/>
			<xs:enumeration value="hex"/>
			<xs:enumeration value="bin"/>
			<xs:enumeration value="ascii"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="tpEnum">
	  <xs:sequence>  
		<xs:element name="item" maxOccurs="unbounded">
			<xs:complexType>
				<xs:sequence>  
					<xs:element name="value" type="xs:int"/>
					<xs:element name="text" type="xs:string"/>
				</xs:sequence>  
			</xs:complexType>
		</xs:element>
	  </xs:sequence>  
	</xs:complexType>  
	<xs:simpleType name="tpRegNum40000">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="40000"/>
			<xs:maxInclusive value="49999"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="tpRegNum400000">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="400000"/>
			<xs:maxInclusive value="465536"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="tpRegAutonum">
	   <xs:restriction base="xs:string">
		 <xs:enumeration value="*"/>
	   </xs:restriction>
	</xs:simpleType> 										
</xs:schema>