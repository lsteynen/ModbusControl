<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
	  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
	  <SelfContained>true</SelfContained>
	  <!-- Keep only the languages you actually support -->
	  <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	  <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
	 <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
	 <ApplicationDefaultFont>Microsoft Sans Serif, 8.25pt</ApplicationDefaultFont>
	 <ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
	 <ApplicationIcon>Ico5.ico</ApplicationIcon>
	 <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);TESTBUILD</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
    <DefineConstants>$(DefineConstants);CHECKFORUPDATE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Modbus_netx\**" />
    <Compile Remove="Sharedx\**" />
    <EmbeddedResource Remove="Modbus_netx\**" />
    <EmbeddedResource Remove="Sharedx\**" />
    <None Remove="Modbus_netx\**" />
    <None Remove="Sharedx\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Modbus_net\ByteQueue.cs" Link="v_Modbus_net\ByteQueue.cs" />
    <Compile Include="..\Modbus_net\ICommChannel.cs" Link="v_Modbus_net\ICommChannel.cs" />
    <Compile Include="..\Modbus_net\IModbusProtocol.cs" Link="v_Modbus_net\IModbusProtocol.cs" />
    <Compile Include="..\Modbus_net\ModbusProtocol.cs" Link="v_Modbus_net\ModbusProtocol.cs" />
    <Compile Include="..\Modbus_net\ModbusRTUProtocol.cs" Link="v_Modbus_net\ModbusRTUProtocol.cs" />
    <Compile Include="..\Modbus_net\ModbusTCPProtocol.cs" Link="v_Modbus_net\ModbusTCPProtocol.cs" />
    <Compile Include="..\Modbus_net\SerialChannel.cs" Link="v_Modbus_net\SerialChannel.cs" />
    <Compile Include="..\Modbus_net\TcpChannel.cs" Link="v_Modbus_net\TcpChannel.cs" />
    <Compile Include="..\Shared\AppDpiHelpers.cs" Link="v_Shared\AppDpiHelpers.cs" />
    <Compile Include="..\Shared\AppHelpers.cs" Link="v_Shared\AppHelpers.cs" />
    <Compile Include="..\Shared\AssemblyInfoShared.cs" Link="v_Shared\AssemblyInfoShared.cs" />
    <Compile Include="..\Shared\BytesToString.cs" Link="v_Shared\BytesToString.cs" />
    <Compile Include="..\Shared\CLogger.cs" Link="v_Shared\CLogger.cs" />
    <Compile Include="..\Shared\ColorFromString.cs" Link="v_Shared\ColorFromString.cs" />
    <Compile Include="..\Shared\Converts.cs" Link="v_Shared\Converts.cs" />
    <Compile Include="..\Shared\CsvFileHandler.cs" Link="v_Shared\CsvFileHandler.cs" />
    <Compile Include="..\Shared\FindFileAssociation.cs" Link="v_Shared\FindFileAssociation.cs" />
    <Compile Include="..\Shared\Global.cs" Link="v_Shared\Global.cs" />
    <Compile Include="..\Shared\ProjectFileHandler.cs" Link="v_Shared\ProjectFileHandler.cs" />
    <Compile Include="..\Shared\RegisterToOffset.cs" Link="v_Shared\RegisterToOffset.cs" />
    <Compile Include="..\Shared\ValueToString.cs" Link="v_Shared\ValueToString.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Ico5.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.11" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="&quot;$(ProjectDir)\Properties\IncBuildNo.exe&quot; &quot;$(ProjectDir)..\Shared\AssemblyInfoShared.cs&quot; $(ConfigurationName)" />
  </Target>

</Project>