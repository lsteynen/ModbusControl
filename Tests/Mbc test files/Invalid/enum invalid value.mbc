<?xml version="1.0" encoding="utf-8"?>
<modbuscontrol>
	<modbus>
	</modbus>
	<tab>
		<name>Test1</name>
		<var>
			<reg>40001</reg>
			<text>Software version</text>
			<type>int16</type>
			<rw>r</rw>
			<enum>
				<item>
					<value>1</value>
					<text>no alarm</text>
				</item>
				<item>
					<value>aa</value>
					<text>T1 FAIL</text>
				</item>
			</enum>
		</var>
	</tab>
</modbuscontrol>