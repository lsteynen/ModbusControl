			<type>int16</type>
			<rw>r</rw>
		</var>
	</tab>
	
	<include>
		<file>extra_configuration.mbci</file>
		<required>true</required>
	</include>
	<include>
		<file>extra_configuration2.mbci</file>
		<required>false</required>
	</include>
	
</modbuscontrol>
