		</var>		
		<var>	
			<reg>40041</reg>
			<text>TEXT</text>
			<type>int16</type>
			<rw>r</rw>
			<enum>
				<item>
					<value>0</value>
					<text>no alarm</text>
				</item>
				<item>
					<value>1</value>
					<text>T1 FAIL</text>
				</item>
				<item>
					<value>2</value>
					<text>T1 TOO HOT</text>
				</item>
				<item>
					<value>3</value>
					<text>T2 FAIL</text>
				</item>
				<item>
					<value>4</value>
					<text>T2 TOO HOT</text>
				</item>
			</enum>
		</var>
		<var>	
			<reg>40041</reg>
			<text>TEXT</text>
			<type>int16</type>
			<rw>r</rw>
			<enum>
				<item>
					<value>0</value>
					<text>no alarm</text>
				</item>
				<item>
					<value>1</value>
					<text>T1 FAIL</text>
				</item>
				<else>INVALID VALUE
				</else>
			</enum>
		</var>
	</tab>
	
	<tab>
		<name>Tab02</name>
		<expandfields>false</expandfields>
		<exportorder>123</exportorder>
		<fcol>#0007f0</fcol>
		<bcol>#ff8010</bcol>
		<var>
			<reg>40001</reg>
