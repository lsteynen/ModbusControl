		<var>
			<reg>40002</reg>
			<text>TEXT_0002</text>
			<type>int16</type>
			<rw>r</rw>
			<fcol>0,120,255</fcol>
			<bcol>254,110,10</bcol>
		</var>
		<var>
			<reg>40003</reg>
			<text>TEXT_0003</text>
			<type>int16</type>
			<rw>r</rw>
			<fcol>#0007f0</fcol>
			<bcol>#ff8010</bcol>
		</var>
		
		<var>
			<reg>40004</reg>
			<text>TEXT_0004</text>
			<longdescr>This is a long description that shows as a tooltip.
Digital inputs bitmap. Each bit corresponds with a digital input.</longdescr>
			<type>int16</type>
			<rw>r</rw>
		</var>
		
		<var>
			<reg>40005</reg>
			<text>TEXT_0005</text>
			<type>int16</type>
			<minlen>4</minlen>
			<rw>r</rw>
		</var>
		<var>
			<reg>40005</reg>
			<text>TEXT_0005</text>
			<type>int16</type>
			<minlen>20</minlen>
			<rw>r</rw>
		</var>
		
		<var>
			<reg>40005</reg>
			<text>TEXT_0005</text>
			<type>int16</type>
			<decimals>1</decimals>
			<rw>r</rw>
		</var>
		<var>
			<reg>40005</reg>
			<text>TEXT_0005</text>
			<type>int16</type>
			<decimals>3</decimals>
			<rw>r</rw>
		</var>
		<var>
			<reg>40005</reg>
			<text>TEXT_0005</text>
			<type>int16</type>
			<decimals>6</decimals>
			<rw>r</rw>
		</var>
		
		<var>
			<reg>40006</reg>
			<text>TEXT_0006</text>
			<type>int16</type>
			<rw>r</rw>
		</var>
		<var>
			<reg>40006</reg>
			<text>TEXT_0006</text>
