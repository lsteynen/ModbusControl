			<rw>rw</rw>
		</var>
		<var>
			<reg>40006</reg>
			<text>TEXT_0006</text>
			<type>int16</type>
			<rw>w</rw>
		</var>
		
		<var>
			<reg>40007</reg>
			<text>TEXT_0007 &lt; &gt; &amp; &apos; &quot;</text>
			<type>int16</type>
			<rw>w</rw>
		</var>
		<var>
			<reg>40007</reg>
			<text>Temperature 1 &#176;C</text>
			<type>int16</type>
			<rw>w</rw>
		</var>
		
		<var>
			<reg>40008</reg>
			<text>TEXT_0008</text>
			<type>int16</type>
			<minlen>8</minlen>
			<rw>r</rw>
			<expandfields>true</expandfields>
			<field>
				<pos>0</pos>
				<text>RESET</text>
			</field>
			<field>
				<pos>1</pos>
				<text>IN1</text>
				<bcol>255,230,230</bcol>
			</field>
			<field>
				<pos>2</pos>
				<text>IN2</text>
				<longdescr>This is a long description.
				It shows as a tooltip.
				Can span multiple lines.
				</longdescr>
			</field>
			<field>
				<pos>3</pos>
				<text>IN3</text>
			</field>
			<field>
				<pos>4</pos>
				<text>IN4</text>
			</field>
		</var>
		<var>
			<reg>40008</reg>
			<text>TEXT_0008</text>
			<type>int16</type>
			<field>
				<pos>0</pos>
				<text>RESET</text>
				<fcol>100,100,100</fcol>
				<bcol>255,230,230</bcol>
			</field>
			<field>
				<pos>15</pos>
				<text>IN1</text>
			</field>
			<field>
				<pos>3</pos>
				<width>1</width>
				<text>IN1</text>
			</field>
			<field>
				<pos>3</pos>
				<width>2</width>
				<text>IN1</text>
			</field>
			<field>
				<pos>3</pos>
				<width>8</width>
				<text>IN1</text>
			</field>
			<field>
				<pos>3</pos>
				<width>13</width>
				<text>IN1</text>
			</field>
			<field>
				<pos>2</pos>
				<text>IN2</text>
				<longdescr>This is a long description.
				It shows as a tooltip.
				Can span multiple lines.
				</longdescr>
			</field>
			<field>
				<pos>3</pos>
				<text>IN3</text>
			</field>
			<field>
				<pos>4</pos>
				<text>IN4</text>
			</field>
		</var>
		<var>
			<reg>40008</reg>
			<text>TEXT_0008</text>
			<type>uint32</type>
			<field>
				<pos>0</pos>
				<text>RESET</text>
				<fcol>100,100,100</fcol>
				<bcol>255,230,230</bcol>
			</field>
			<field>
				<pos>31</pos>
				<text>IN1</text>
			</field>
			<field>
				<pos>3</pos>
				<width>1</width>
				<text>IN1</text>
			</field>
			<field>
