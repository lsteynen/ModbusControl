<?xml version="1.0" encoding="utf-8"?>
<modbuscontrol>
	<size>
		<width>880</width>
		<height>890</height>
	</size>
	<modbus>
		<connection>modbus/tcp</connection>
		<!-- <connection>modbus/tcp</connection> -->
		<!-- <connection>rtu/tcp</connection> -->
		<!-- Serial parameters -->
		<port></port>
		<baudrate>9600</baudrate>
		<parity>none</parity>
		<endofmessagetimeout>100</endofmessagetimeout>
		<onewireechosuppression>false</onewireechosuppression>
		<!-- TCP/IP parameters -->
		<ipaddress>127.0.0.1</ipaddress>
		<ipport>502</ipport>
		<!-- General parameters -->
		<slaveid>1</slaveid>
		<responsetimeout>1000</responsetimeout>
		<maximumframesize>256</maximumframesize>
		<writeholdingregisterfc>6</writeholdingregisterfc>
		<int32endian>little</int32endian>
		<float32endian>little</float32endian>
		<stringendian>little</stringendian>
		<stringencoding>windows-1252</stringencoding>
		<samplerate>1000</samplerate>
		<holdingregisterstart>40001</holdingregisterstart>
		<interframedelay>0</interframedelay>
	</modbus>
	<modbustcpserver> 
		<enable>true</enable>
		<port>503</port>
	</modbustcpserver> 
	<autostart>
		<enable>true</enable>
		<page>1</page>
	</autostart>
	<tab>
		<name>Tab01</name>
		<expandfields>false</expandfields>
		<exportorder>123</exportorder>
		<fcol>0,120,255</fcol>
		<bcol>254,110,10</bcol>
		
		<var>
			<reg>40001</reg>
			<text>TEXT_0001</text>
			<type>int16</type>
			<rw>r</rw>
		</var>
		<var>
			<reg>40001</reg>
			<text>TEXT_0001</text>
			<type>uint16</type>
			<rw>r</rw>
		</var>	
		<var>
			<reg>40001</reg>
			<text>TEXT_0001</text>
			<type>hex16</type>
			<rw>r</rw>
		</var>	
		<var>
