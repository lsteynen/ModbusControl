<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

	<?define SourceAppExeDir = "..\ModbusControl\bin\Release\net9.0-windows10.0.17763.0\publish\win-x64" ?>
	<?define SourceAppPdfDir = "..\Manuals" ?>
	<?define SourceDemoMbc = "..\mbc" ?>
	<?define SourceXsd = "..\xsd" ?>
	<?define SourceUpdater = "..\Updater" ?>

	<Fragment>

		<ComponentGroup Id="ModbusControlComponents">

			<!-- Explicitly add ModbusControl.exe -->
			<Component Id="MainComponent"
					   Directory="INSTALLFOLDER">
				<File Id="ModbusControl_exe"
					Source="$(var.SourceAppExeDir)\ModbusControl.exe"
					KeyPath="yes"/>
			
				<!-- =========================================================
					 .MBC FILE ASSOCIATION
					 Double-clicking a .mbc file starts ModbusControl.exe
					 ========================================================= -->
				<ProgId Id="lsteynen.ModbusControl"
						Description="ModbusControl project file"
						Icon="ModbusControl_exe" IconIndex="0">
					<Extension Id="mbc" Advertise="no">
						<Verb Id="open"
							  Command="Open"
							  TargetFile="ModbusControl_exe"
							  Argument="&quot;%1&quot;" />
					</Extension>
				</ProgId>
			</Component>

			<!-- Harvest all other files from SourceAppExeDir, including subdirectories -->
			<Files Include="$(var.SourceAppExeDir)\**"
				   Directory="INSTALLFOLDER">

				<!-- ModbusControl.exe is already explicitly included above -->
				<Exclude Files="$(var.SourceAppExeDir)\ModbusControl.exe" />

			</Files>

			<!-- Harvest PDF files -->
			<Files Include="$(var.SourceAppPdfDir)\*.pdf"
				   Directory="INSTALLFOLDER">
			</Files>

			<!-- Harvest Demo.mbc -->
			<Files Include="$(var.SourceDemoMbc)\Demo.mbc"
				   Directory="INSTALLFOLDER">
			</Files>

			<!-- Harvest MbcValidate.xsd -->
			<Files Include="$(var.SourceXsd)\MbcValidate.xsd"
				   Directory="INSTALLFOLDER">
			</Files>

			<!-- Harvest the Updater --> 
			<Files Include="$(var.SourceUpdater)\*.*"
				   Directory="INSTALLFOLDER">
			</Files>

			<!-- Desktop shortcut -->
			<Component Id="ModbusControlDesktopShortcutComponent"
					   Directory="DesktopFolder"
					   Guid="{B7D6E6F1-4A25-4B91-9C57-6E4E9A2F31C8}">

				<Shortcut Id="ModbusControlDesktopShortcut"
						  Name="ModbusControl"
						  Description="Launch ModbusControl"
						  Target="[INSTALLFOLDER]ModbusControl.exe"
						  WorkingDirectory="INSTALLFOLDER" />

				<!-- Registry value provides the required HKCU key path
			     for this non-advertised shortcut component. -->
				<RegistryValue Root="HKCU"
							   Key="Software\ModbusControl"
							   Name="DesktopShortcut"
							   Type="integer"
							   Value="1"
							   KeyPath="yes" />

			</Component>

			<!-- Start Menu shortcuts -->
			<Component Id="ModbusControlStartMenuComponent"
					   Directory="ModbusControlStartMenuFolder"
					   Guid="{D2A7B6C4-8E31-4F52-A9D6-3C7B5E1F2048}">

				<!-- Start Menu shortcut to ModbusControl.exe -->
				<Shortcut Id="ModbusControlStartMenuShortcut"
						  Name="ModbusControl"
						  Description="Launch ModbusControl"
						  Target="[INSTALLFOLDER]ModbusControl.exe"
						  WorkingDirectory="INSTALLFOLDER" />

				<!-- Start Menu shortcut to user manual pdf -->
				<Shortcut Id="ModbusControlUserManualShortcut"
						  Name="User Manual"
						  Description="ModbusControl User Manual"
						  Target="[INSTALLFOLDER]ModbusControl - User manual.pdf"
						  WorkingDirectory="INSTALLFOLDER" />

				<!-- Start Menu shortcut to release notes pdf -->
				<Shortcut Id="ModbusControlReleaseNotesShortcut"
						  Name="Release Notes"
						  Description="ModbusControl Release Notes"
						  Target="[INSTALLFOLDER]ModbusControl - Release notes.pdf"
						  WorkingDirectory="INSTALLFOLDER" />

				<!-- Remove the ModbusControl Start Menu folder on uninstall -->
				<RemoveFolder Id="RemoveModbusControlStartMenuFolder"
							  On="uninstall" />

				<!-- Registry value provides the component key path -->
				<RegistryValue Root="HKCU"
							   Key="Software\ModbusControl"
							   Name="StartMenuShortcuts"
							   Type="integer"
							   Value="1"
							   KeyPath="yes" />

			</Component>

			<!-- Create C:\ProgramData\ModbusControl directory -->
			<Component Id="ModbusControlProgramDataComponent"
						Directory="PROGRAMDATAFOLDER"
						Guid="{7A9E0E8B-7B1D-4A5D-9C2A-8F4E6B21D317}">

				<CreateFolder />

			</Component>

		</ComponentGroup>

	</Fragment>
</Wix>
