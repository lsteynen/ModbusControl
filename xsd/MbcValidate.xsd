<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="modbuscontrol">
		<xs:complexType>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element name="size">
					<xs:complexType>
						<xs:all>
							<xs:element name="width" type="xs:unsignedInt" minOccurs="0"/>
							<xs:element name="height" type="xs:unsignedInt" minOccurs="0"/>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="modbus">
					<xs:complexType>
						<xs:all>
							<xs:element name="connection" type="ConnectionType" minOccurs="0"/>
							<xs:element name="port" type="xs:string" minOccurs="0"/>
							<xs:element name="baudrate" type="BaudrateType" minOccurs="0"/>
							<xs:element name="parity" type="ParityType" minOccurs="0"/>
							<xs:element name="endofmessagetimeout" type="xs:unsignedInt" minOccurs="0"/>
							<xs:element name="onewireechosuppression" type="BoolType" minOccurs="0"/>
							<xs:element name="ipaddress" type="xs:string" minOccurs="0"/>
							<xs:element name="ipport" type="IPPortType" minOccurs="0"/>
							<xs:element name="slaveid" type="ModbusSlaveIDType" minOccurs="0"/>
							<xs:element name="maximumframesize" minOccurs="0">
								<xs:simpleType>
									<xs:restriction base="xs:integer">
										<xs:minInclusive value="13"/>
										<xs:maxInclusive value="256"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="interframedelay" type="xs:unsignedInt" minOccurs="0"/>
							<xs:element name="writeholdingregisterfc" type="ModbusWriteFCType" minOccurs="0"/>
							<xs:element name="int32endian" type="EndianType" minOccurs="0"/>
							<xs:element name="float32endian" type="EndianType" minOccurs="0"/>
							<xs:element name="ascii16endian" type="EndianType" minOccurs="0"/>
							<xs:element name="showinfo" type="BoolType" minOccurs="0"/>
							<xs:element name="holdingregisterstart" type="ModbusHoldingRegisterStartType" minOccurs="0"/>
							<xs:element name="responsetimeout" type="xs:unsignedInt" minOccurs="0"/>
							<xs:element name="samplerate" type="xs:unsignedInt" minOccurs="0"/>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="autostart">
					<xs:complexType>
						<xs:all>
							<xs:element name="enable" type="BoolType" minOccurs="0"/>
							<xs:element name="page" type="xs:string" minOccurs="0"/>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="modbustcpserver">
					<xs:complexType>
						<xs:all>
							<xs:element name="enable" type="BoolType" minOccurs="0"/>
							<xs:element name="port" type="IPPortType" minOccurs="0"/>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element name="tab">
					<xs:complexType>
						<xs:choice maxOccurs="unbounded">
							<xs:element name="name" type="xs:string" minOccurs="1"/>
							<xs:element name="rw" type="ReadWriteType"/>
							<xs:element name="minlen">
								<xs:simpleType>
									<xs:restriction base="xs:integer">
										<xs:minInclusive value="1"/>
										<xs:maxInclusive value="32"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="decimals">
								<xs:simpleType>
									<xs:restriction base="xs:integer">
										<xs:minInclusive value="0"/>
										<xs:maxInclusive value="12"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="fcol" type="xs:string"/>
							<xs:element name="bcol" type="xs:string"/>
							<xs:element name="expandfields" type="BoolType"/>
							<xs:element name="var">
								<xs:complexType>
									<xs:choice maxOccurs="unbounded">
										<xs:element name="reg" minOccurs="1">
										   <xs:simpleType>
											 <xs:union memberTypes="RegNum40000Type RegNum400000Type RegAutonumType"/>
										   </xs:simpleType>
										</xs:element>
										<xs:element name="text" type="xs:string"/>
										<xs:element name="longdescr" type="xs:string"/>
										<xs:element name="type" type="VartypeType"/>
										<xs:element name="rw" type="ReadWriteType"/>
										<xs:element name="minlen">
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:minInclusive value="1"/>
													<xs:maxInclusive value="32"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="decimals">
											<xs:simpleType>
												<xs:restriction base="xs:integer">
													<xs:minInclusive value="0"/>
													<xs:maxInclusive value="12"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="fcol" type="xs:string"/>
										<xs:element name="bcol" type="xs:string"/>
										<xs:element name="expandfields" type="BoolType"/>
										<xs:element name="enum" type="EnumType"/>
										<xs:element name="field">
											<xs:complexType>
												<xs:all>
													<xs:element name="pos" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:integer">
																<xs:minInclusive value="0"/>
																<xs:maxInclusive value="31"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="width" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:integer">
																<xs:minInclusive value="1"/>
																<xs:maxInclusive value="32"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="text" type="xs:string" minOccurs="0"/>
													<xs:element name="longdescr" type="xs:string" minOccurs="0"/>
													<xs:element name="type" type="FieldtypeType" minOccurs="0"/>
													<xs:element name="minlen" minOccurs="0">
														<xs:simpleType>
															<xs:restriction base="xs:integer">
																<xs:minInclusive value="1"/>
																<xs:maxInclusive value="32"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="fcol" type="xs:string" minOccurs="0"/>
													<xs:element name="bcol" type="xs:string" minOccurs="0"/>
													<xs:element name="enum" type="EnumType" minOccurs="0"/>
												</xs:all>
											</xs:complexType>
										</xs:element>
									</xs:choice>
								</xs:complexType>
							</xs:element>
						</xs:choice>
					</xs:complexType>
				</xs:element>
				<xs:element name="include">
					<xs:complexType>
						<xs:all>
							<xs:element name="file" type="xs:string" minOccurs="1"/>
							<xs:element name="required" type="BoolType" minOccurs="0"/>
						</xs:all>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="ConnectionType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="serial/rtu"/>
			<xs:enumeration value="modbus/tcp"/>
			<xs:enumeration value="rtu/tcp"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="BaudrateType">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="50"/>
			<xs:maxInclusive value="99999999"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="BoolType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="true"/>
			<xs:enumeration value="false"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EndianType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="big"/>
			<xs:enumeration value="little"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ParityType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="none"/>
			<xs:enumeration value="odd"/>
			<xs:enumeration value="even"/>
			<xs:enumeration value="mark"/>
			<xs:enumeration value="space"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="IPPortType">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="65535"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ModbusSlaveIDType">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="0"/>
			<xs:maxInclusive value="255"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ModbusHoldingRegisterStartType">
		<xs:restriction base="xs:integer">
			<xs:enumeration value="40000"/>
			<xs:enumeration value="40001"/>
			<xs:enumeration value="400000"/>
			<xs:enumeration value="400001"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ModbusWriteFCType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="6"/>
			<xs:enumeration value="06"/>
			<xs:enumeration value="16"/>
			<xs:enumeration value="auto"/>
			<xs:enumeration value="alternate"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ReadWriteType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="r"/>
			<xs:enumeration value="w"/>
			<xs:enumeration value="rw"/>
			<xs:enumeration value="wr"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="VartypeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="int16"/>
			<xs:enumeration value="uint16"/>
			<xs:enumeration value="int32"/>
			<xs:enumeration value="uint32"/>
			<xs:enumeration value="hex16"/>
			<xs:enumeration value="hex32"/>
			<xs:enumeration value="bin16"/>
			<xs:enumeration value="bin32"/>
			<xs:enumeration value="float32"/>
			<xs:enumeration value="ascii16"/>
			<xs:enumeration value="ascii32"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FieldtypeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="int"/>
			<xs:enumeration value="uint"/>
			<xs:enumeration value="hex"/>
			<xs:enumeration value="bin"/>
			<xs:enumeration value="ascii"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="EnumType">
	  <xs:sequence>  
		<xs:element name="item" maxOccurs="unbounded">
			<xs:complexType>
				<xs:sequence>  
					<xs:element name="value" type="xs:int"/>
					<xs:element name="text" type="xs:string"/>
				</xs:sequence>  
			</xs:complexType>
		</xs:element>
		<xs:element name="else" type="xs:string" minOccurs="0" maxOccurs="1">
		</xs:element>
	  </xs:sequence>  
	</xs:complexType>  
	<xs:simpleType name="RegNum40000Type">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="40000"/>
			<xs:maxInclusive value="49999"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="RegNum400000Type">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="400000"/>
			<xs:maxInclusive value="465536"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="RegAutonumType">
	   <xs:restriction base="xs:string">
		 <xs:enumeration value="*"/>
	   </xs:restriction>
	</xs:simpleType> 										
</xs:schema>